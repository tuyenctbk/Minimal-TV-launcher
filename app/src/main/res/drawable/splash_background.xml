<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Midnight Royal-Indigo Studio Gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#070B14"
                android:centerColor="#0F172A"
                android:endColor="#1E1B4B"
                android:type="linear" />
        </shape>
    </item>

    <!-- Centered Brand Emblem matching App Icon & TV Banner -->
    <item
        android:width="144dp"
        android:height="144dp"
        android:gravity="center">
        <vector
            android:width="144dp"
            android:height="144dp"
            android:viewportWidth="120"
            android:viewportHeight="120">
            <!-- Outer Ambient Glow Ring -->
            <path
                android:fillColor="#2038BDF8"
                android:pathData="M60,60m-56,0a56,56 0 1,1 112,0a56,56 0 1,1 -112,0" />
            <!-- Inner Radiant Disc -->
            <path
                android:fillColor="#2E312E81"
                android:pathData="M60,60m-48,0a48,48 0 1,1 96,0a48,48 0 1,1 -96,0" />
            <!-- Stand Neck -->
            <path
                android:fillColor="#A5B4FC"
                android:pathData="M55,83 h10 v8 h-10 z" />
            <!-- Stand Base -->
            <path
                android:fillColor="#E0E7FF"
                android:pathData="M42,91 h36 a2.5,2.5 0 0,1 2.5,2.5 v1.5 a2.5,2.5 0 0,1 -2.5,2.5 h-36 a2.5,2.5 0 0,1 -2.5,-2.5 v-1.5 a2.5,2.5 0 0,1 2.5,-2.5 z" />
            <!-- TV Monitor Outer Frame -->
            <path
                android:fillColor="#C7D2FE"
                android:pathData="M24,25 h72 a8,8 0 0,1 8,8 v44 a8,8 0 0,1 -8,8 h-72 a8,8 0 0,1 -8,-8 v-44 a8,8 0 0,1 8,-8 z" />
            <!-- TV Screen Inner Deep Glass Canvas -->
            <path
                android:fillColor="#090D16"
                android:pathData="M28,29 h64 a4,4 0 0,1 4,4 v36 a4,4 0 0,1 -4,4 h-64 a4,4 0 0,1 -4,-4 v-36 a4,4 0 0,1 4,-4 z" />
            <!-- Diagonal Glare -->
            <path
                android:fillColor="#14FFFFFF"
                android:pathData="M32,29 L66,29 L50,73 L32,73 Z" />
            <!-- Protective Shield -->
            <path
                android:fillColor="#38BDF8"
                android:pathData="M60,34 C69,34 74,38 74,38 C74,52 65,60 60,64 C55,60 46,52 46,38 C46,38 51,34 60,34 Z" />
            <!-- Inner Shield Core -->
            <path
                android:fillColor="#4F46E5"
                android:pathData="M60,37.5 C66.5,37.5 70.5,40.5 70.5,40.5 C70.5,50.5 63.5,56.5 60,59.5 C56.5,56.5 49.5,50.5 49.5,40.5 C49.5,40.5 53.5,37.5 60,37.5 Z" />
            <!-- Play Arrow -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M57.5,43 L66.5,49 L57.5,55 Z" />
            <!-- Status LED -->
            <path
                android:fillColor="#10B981"
                android:pathData="M60,79m-1.8,0a1.8,1.8 0 1,1 3.6,0a1.8,1.8 0 1,1 -3.6,0" />
        </vector>
    </item>
</layer-list>
