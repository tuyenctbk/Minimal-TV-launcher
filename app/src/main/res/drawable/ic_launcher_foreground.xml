    <!-- Subtle Ambient Glow behind TV -->
    <path
        android:pathData="M54,49m-28,0a28,28 0 1,1 56,0a28,28 0 1,1 -56,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="49"
